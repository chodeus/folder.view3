#!/usr/bin/env bash
# pre-push: refuse a push to main or beta whose folder.view3.plg pluginURL names the other
# branch (a main<->beta merge clobbers it). Setup once per clone: git config core.hooksPath .githooks
# Override (rare): git push --no-verify

set -eu

plg="folder.view3.plg"
zero="0000000000000000000000000000000000000000"
status=0

# One line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in
    refs/heads/main) branch=main ;;
    refs/heads/beta) branch=beta ;;
    *) continue ;;
  esac
  [ "$local_sha" != "$zero" ] || continue

  # Check the manifest as it will land on the remote, not the working tree
  if ! content=$(git show "$local_sha:$plg" 2>/dev/null); then
    echo "ERROR: pre-push blocked — $plg is missing or unreadable in $local_sha (push to $branch)."
    status=1
    continue
  fi
  actual_url=$(printf '%s\n' "$content" | grep '<!ENTITY pluginURL' | sed -E 's/.*"([^"]+)".*/\1/' || true)
  expected_segment="&github;/${branch}/&name;.plg"

  if ! printf '%s' "$actual_url" | grep -qF "$expected_segment"; then
    echo "ERROR: pre-push blocked — $plg pluginURL in $local_sha doesn't match branch '$branch'."
    echo "  Expected segment: $expected_segment"
    echo "  Actual URL:       $actual_url"
    echo ""
    echo "Fix it:"
    echo "  1. Edit $plg and set"
    echo "       <!ENTITY pluginURL \"https://raw.githubusercontent.com/&github;/${branch}/&name;.plg\">"
    echo "  2. Re-commit, then push again."
    echo ""
    echo "If you genuinely need to push without fixing this, use:  git push --no-verify"
    status=1
  fi
done

exit $status
