{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>chodeus/chodeus-ops"],
  "forkProcessing": "enabled",
  "baseBranchPatterns": ["beta"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Each release row of the CI matrix's Unraid list, moved to the newest patch of its minor.",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["- \\{unraid: '(?<currentValue>[^']+)', php: '[^']+'\\}"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "unraid/webgui",
      "depTypeTemplate": "unraid-release",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "The matrix's 'newest tag' row: the newest Unraid tag of any kind, betas and release candidates included.",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["- \\{unraid: '(?<currentValue>[^']+)', php: '[^']+', row: 'newest tag'\\}"],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "unraid/webgui",
      "depTypeTemplate": "unraid-newest-tag",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "actionlint's release tag and tarball SHA-256 in validate-workflows.yml; Renovate takes the same asset's hash from the new release.",
      "managerFilePatterns": ["/^\\.github/workflows/validate-workflows\\.yml$/"],
      "matchStrings": [
        "ACTIONLINT_VERSION:\\s*(?<currentValue>[^\\s]+)\\s+ACTIONLINT_SHA256:\\s*(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "rhysd/actionlint"
    },
    {
      "customType": "regex",
      "description": "Bundled libraries released on npm; vendor-sync.yml copies the new files in.",
      "managerFilePatterns": ["/^vendor\\.json$/"],
      "matchStrings": [
        "\"npm\":\\s*\"(?<depName>[^\"]+)\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "depTypeTemplate": "bundled"
    },
    {
      "customType": "regex",
      "description": "Bundled libraries taken from an upstream branch; Renovate moves the commit, vendor-sync.yml copies the new files in.",
      "managerFilePatterns": ["/^vendor\\.json$/"],
      "matchStrings": [
        "\"github\":\\s*\"(?<depName>[^\"]+)\",\\s*\"branch\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"commit\":\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "depTypeTemplate": "bundled"
    }
  ],
  "packageRules": [
    {
      "description": "Release rows take Unraid releases only (webgui also carries 2014.x date tags, which sort above every 7.x), within their minor.",
      "matchDepTypes": ["unraid-release"],
      "allowedVersions": "/^\\d{1,2}\\.\\d+\\.\\d+$/"
    },
    {
      "description": "A new minor gets a row of its own by hand, so a release row never leaves its minor.",
      "matchDepTypes": ["unraid-release"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Unraid releases and their betas and release candidates, still without the date tags.",
      "matchDepTypes": ["unraid-newest-tag"],
      "allowedVersions": "/^\\d{1,2}\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$/",
      "ignoreUnstable": false
    },
    {
      "description": "One Unraid PR, merged by hand: a patch can change the PHP a release ships (7.2.8 did), so each row's php is checked against the release notes.",
      "matchDepNames": ["unraid/webgui"],
      "groupName": "Unraid versions",
      "automerge": false
    },
    {
      "description": "Bundled libraries ship to users, so their updates are fix(deps).",
      "matchDepTypes": ["bundled"],
      "semanticCommitType": "fix"
    },
    {
      "description": "One PR for the non-major bundled updates. The preset automerges minor and patch but not digests, so an upstream-branch commit is merged by hand.",
      "matchDepTypes": ["bundled"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "bundled libraries"
    },
    {
      "description": "A new npm release waits 7 days before it is bundled; a hijacked publish is normally pulled within that.",
      "matchDepTypes": ["bundled"],
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Unraid's webGui ships jQuery 3.7.1; the folder editor DOM test runs on the same major.",
      "matchFileNames": [".github/scripts/package.json"],
      "matchPackageNames": ["jquery"],
      "allowedVersions": "<4"
    }
  ]
}
